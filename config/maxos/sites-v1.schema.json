{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "url": { "type": "string" },
    "description": {
      "type": ["string", "object"],
      "description": "A string description or an object map of localized descriptions.",
      "additionalProperties": { "type": "string" }
    },
    "iconUrl": { "type": "string" },
    "openIn": {
      "type": "string",
      "enum": ["in-page", "new-tab"]
    },
    "category": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
